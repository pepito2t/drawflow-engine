{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Drawflow",
  "version": "0.1.0-rc.1",
  "identifier": "ch.drawflow.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Drawflow",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560,
        "theme": "Dark",
        "backgroundColor": "#111317"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/engine"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
